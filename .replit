modules = ["web", "python-3.11", "postgresql-16", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "imagemagick", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[agent]
expertMode = true
integrations = ["replitmail:1.0.0", "mailchimp:1.0.0", "resend:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 5000

[[ports]]
localPort = 5051
externalPort = 3002

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
MAILCHIMP_LIST_ID = "a090381f0a"
WHOP_API_VERSION_DATE = "2026-09-15"
WHOP_ACCOUNT_ID = "biz_tdAP8i9chimoH0"
WHOP_FREE_PRODUCT_ID = "prod_l5NFKgPqbjDnG"
DISCORD_GUILD_ID = "1551161248052420678"
DISCORD_COMMUNITY_ROLE_ID = "1551180940565286912"
DISCORD_PRO_ROLE_ID = "1551181384578506855"
DISCORD_TEAM_ROLE_ID = "1551181820442316891"
DISCORD_MEMBERSHIP_LOG_CHANNEL_ID = "1551183999731240990"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
