{
  "headers": [
    {
      "source": "/videos/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/videos/:path*.mp4",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/insights", "destination": "https://ipm-services-kevinajackson21.replit.app/insights" },
    { "source": "/es/insights", "destination": "https://ipm-services-kevinajackson21.replit.app/es/insights" },
    { "source": "/insights/learn/:slug", "destination": "https://ipm-services-kevinajackson21.replit.app/insights/learn/:slug" },
    { "source": "/es/insights/learn/:slug", "destination": "https://ipm-services-kevinajackson21.replit.app/es/insights/learn/:slug" },
    { "source": "/insights/topics/:category", "destination": "https://ipm-services-kevinajackson21.replit.app/insights/topics/:category" },
    { "source": "/es/insights/topics/:category", "destination": "https://ipm-services-kevinajackson21.replit.app/es/insights/topics/:category" },
    { "source": "/resources/:path*", "destination": "https://ipm-services-kevinajackson21.replit.app/resources/:path*" },
    { "source": "/es/resources/:path*", "destination": "https://ipm-services-kevinajackson21.replit.app/es/resources/:path*" },
    { "source": "/admin/education", "destination": "https://ipm-services-kevinajackson21.replit.app/admin/education" },
    { "source": "/sign-in/:path*", "destination": "https://ipm-services-kevinajackson21.replit.app/sign-in/:path*" },
    { "source": "/sign-up/:path*", "destination": "https://ipm-services-kevinajackson21.replit.app/sign-up/:path*" },
    { "source": "/sitemap.xml", "destination": "https://ipm-services-kevinajackson21.replit.app/sitemap.xml" },
    { "source": "/properties/:slug", "destination": "https://ipm-services-kevinajackson21.replit.app/properties/:slug" },
    { "source": "/api/:path*", "destination": "https://ipm-services-kevinajackson21.replit.app/api/:path*" }
  ]
}
